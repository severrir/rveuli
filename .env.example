# Supabase — Project Settings → Data API
# Without these the app runs on seed data with a local demo sign-in.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Web Push — generate with: npx web-push generate-vapid-keys
# Only the public key belongs here. The private key is a Supabase secret.
VITE_VAPID_PUBLIC_KEY=
